  "grammar": [
    {
      "id": "seems",
      "title": "A-(으)ㄴ가 보다, V-나 보다, N인가 보다",
      "pattern": "A + (으)ㄴ가 / V + 나 / N + 인가",
      "visual_rules": [
        "A + (으)ㄴ가",
        "V + 나",
        "N + 인가"
      ],
      "use_kr": "보고 들은 근거로 짐작합니다.",
      "use_mn": "Харсан, сонссон зүйлээр таамаглана.",
      "examples": [
        {
          "kr": "사람이 많은가 봐요.",
          "mn": "Хүн ихтэй бололтой."
        },
        {
          "kr": "음식이 매운가 봐요.",
          "mn": "Хоол халуун ногоотой бололтой."
        }
      ]
    },
    {
      "id": "rough_choice",
      "title": "N(이)나",
      "pattern": "받침 O → 이나 / 받침 X → 나",
      "visual_rules": [
        "받침 O → 이나",
        "받침 X → 나"
      ],
      "use_kr": "여러 선택 중 하나를 가볍게 고릅니다.",
      "use_mn": "Хэдэн сонголтоос нэгийг нь хөнгөхөн сонгоно.",
      "examples": [
        {
          "kr": "간식으로 떡이나 먹어요.",
          "mn": "Зуушинд дог ч юм уу идье."
        },
        {
          "kr": "차나 한잔할까요?",
          "mn": "Цай ч юм уу нэг аяга уух уу?"
        }
      ]
    },
    {
      "id": "after_try",
      "title": "V-아/어 보니까",
      "pattern": "동사 + 아·어 보니까",
      "visual_rules": [
        "동사 + 아·어 보니까"
      ],
      "use_kr": "직접 해 본 뒤 알게 된 결과를 말합니다.",
      "use_mn": "Өөрөө хийж үзээд мэдсэн үр дүнг хэлнэ.",
      "examples": [
