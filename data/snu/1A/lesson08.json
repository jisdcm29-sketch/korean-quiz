  "grammar": [
    {
      "id": "suggestion",
      "title": "V-(으)ㄹ까요?",
      "pattern": "받침 O → 을까요? / 받침 X → ㄹ까요?",
      "visual_rules": [
        "받침 O → 을까요?",
        "받침 X → ㄹ까요?"
      ],
      "use_kr": "함께 할 일을 제안합니다.",
      "use_mn": "Хамт хийх зүйлийг санал болгоно.",
      "examples": [
        {
          "kr": "영화 볼까요?",
          "mn": "Кино үзэх үү?"
        },
        {
          "kr": "같이 걸을까요?",
          "mn": "Хамт алхах уу?"
        }
      ]
    },
    {
      "id": "digeut",
      "title": "ㄷ 불규칙",
      "pattern": "듣다 → 들어요 / 걷다 → 걸어요",
      "visual_rules": [
        "듣다 → 들어요",
        "걷다 → 걸어요"
      ],
      "use_kr": "ㄷ이 ㄹ로 바뀝니다.",
      "use_mn": "ㄷ нь ㄹ болж хувирна.",
      "examples": [
        {
          "kr": "음악을 들어요.",
          "mn": "Хөгжим сонсдог."
        },
        {
          "kr": "공원에서 걸어요.",
          "mn": "Цэцэрлэгт алхдаг."
        }
      ]
    },
    {
      "id": "demonstrative_n",
      "title": "이·그·저 N",
      "pattern": "가까이 → 이 N / 멀리 → 그 N / 저 N",
      "visual_rules": [
        "가까이 → 이 N",
        "멀리 → 그 N / 저 N"
      ],
      "use_kr": "명사 앞에서 가리킵니다.",
      "use_mn": "Нэр үгийн өмнө зааж хэлнэ.",
      "examples": [
        {
          "kr": "이 영화가 재미있어요.",
          "mn": "Энэ кино сонирхолтой."
        },
        {
          "kr": "저 사람이 제 친구예요.",
          "mn": "Тэр хүн миний найз."
        }
      ]
    },
    {
      "id": "surprise",
      "title": "A/V-네요",
      "pattern": "형용사 + 네요 / 동사 + 네요",
      "visual_rules": [
        "형용사 + 네요",
        "동사 + 네요"
      ],
      "use_kr": "새로 알거나 느낀 것을 말합니다.",
      "use_mn": "Шинээр мэдсэн, мэдэрснээ хэлнэ.",
      "examples": [
        {
          "kr": "영화가 재미있네요.",
          "mn": "Кино сонирхолтой юм."
        },
        {
          "kr": "피아노를 잘 치네요.",
          "mn": "Төгөлдөр хуур сайн тоглодог юм."
        }
      ]
    }
  ],
