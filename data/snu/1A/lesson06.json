          "mn": "Энд сууна уу."
        },
        {
          "kr": "잠깐 기다리세요.",
          "mn": "Түр хүлээнэ үү."
        }
      ]
    },
    {
      "id": "counter",
      "title": "N 개·병·잔·그릇",
      "pattern": "사과 → 개 / 물 → 병 / 커피 → 잔",
      "visual_rules": [
        "사과 → 개",
        "물 → 병 / 커피 → 잔"
      ],
      "use_kr": "물건의 수를 셉니다.",
      "use_mn": "Юмны тоог тоолно.",
      "examples": [
        {
          "kr": "사과 두 개 주세요.",
          "mn": "Хоёр алим өгнө үү."
        },
        {
          "kr": "커피 한 잔 주세요.",
          "mn": "Нэг аяга кофе өгнө үү."
        }
      ]
    },
    {
      "id": "adjective",
      "title": "N이/가 A-아요/어요",
      "pattern": "맛이 좋아요 / 가격이 비싸요",
      "visual_rules": [
        "맛이 좋아요",
        "가격이 비싸요"
      ],
      "use_kr": "상태나 느낌을 말합니다.",
      "use_mn": "Байдал, шинжийг хэлнэ.",
      "examples": [
        {
          "kr": "짜장면이 맛있어요.",
          "mn": "Жажанмён амттай."
        },
        {
          "kr": "수박이 싸요.",
          "mn": "Тарвас хямд."
        }
      ]
    },
    {
      "id": "also",
      "title": "N도",
      "pattern": "N + 도 / 저도 학생이에요",
      "visual_rules": [
        "N + 도",
        "저도 학생이에요"
      ],
      "use_kr": "같은 내용을 더합니다.",
      "use_mn": "Ижил зүйлийг нэмж хэлнэ.",
      "examples": [
        {
          "kr": "저도 커피를 마셔요.",
          "mn": "Би ч бас кофе уудаг."
        },
        {
          "kr": "만두도 맛있어요.",
          "mn": "Бууз ч бас амттай."
        }
      ]
    }
