  "grammar": [
    {
      "id": "bieup",
      "title": "ㅂ 불규칙",
      "pattern": "춥다 → 추워요 / 덥다 → 더워요",
      "visual_rules": [
        "춥다 → 추워요",
        "덥다 → 더워요"
      ],
      "use_kr": "ㅂ이 우/오로 바뀝니다.",
      "use_mn": "ㅂ нь 우/오 болж хувирна.",
      "examples": [
        {
          "kr": "오늘은 추워요.",
          "mn": "Өнөөдөр хүйтэн."
        },
        {
          "kr": "여름은 더워요.",
          "mn": "Зун халуун."
        }
      ]
    },
    {
      "id": "contrast",
      "title": "A/V-지만",
      "pattern": "앞 내용 + 지만 / 반대 내용",
      "visual_rules": [
        "앞 내용 + 지만",
        "반대 내용"
      ],
      "use_kr": "반대되는 두 내용을 연결합니다.",
      "use_mn": "Эсрэг хоёр утгыг холбоно.",
      "examples": [
        {
          "kr": "춥지만 맑아요.",
          "mn": "Хүйтэн боловч цэлмэг."
        },
        {
          "kr": "비싸지만 맛있어요.",
          "mn": "Үнэтэй боловч амттай."
        }
      ]
    },
    {
      "id": "formal",
      "title": "A/V-습니다·ㅂ니다",
      "pattern": "받침 O → 습니다 / 받침 X → ㅂ니다",
      "visual_rules": [
        "받침 O → 습니다",
        "받침 X → ㅂ니다"
      ],
      "use_kr": "격식 있게 말합니다.",
      "use_mn": "Албан ёсоор хэлнэ.",
      "examples": [
        {
          "kr": "날씨가 좋습니다.",
          "mn": "Цаг агаар сайхан байна."
        },
        {
          "kr": "비가 옵니다.",
          "mn": "Бороо орж байна."
        }
      ]
    },
    {
      "id": "and_state",
      "title": "A/V-고",
      "pattern": "형용사 + 고 / 동사 + 고",
      "visual_rules": [
        "형용사 + 고",
        "동사 + 고"
      ],
      "use_kr": "두 상태나 동작을 연결합니다.",
      "use_mn": "Хоёр байдал, үйлдлийг холбоно.",
      "examples": [
        {
          "kr": "날씨가 맑고 따뜻해요.",
          "mn": "Цэлмэг, дулаахан."
        },
        {
          "kr": "눈이 오고 추워요.",
          "mn": "Цас орж, хүйтэн байна."
        }
      ]
    }
  ],
