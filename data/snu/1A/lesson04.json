  "grammar": [
    {
      "id": "place_copula",
      "title": "여기가 N이에요/예요",
      "pattern": "여기가 + 받침 O 이에요 / 여기가 + 받침 X 예요",
      "visual_rules": [
        "여기가 + 받침 O 이에요",
        "여기가 + 받침 X 예요"
      ],
      "use_kr": "장소를 소개합니다.",
      "use_mn": "Газрыг танилцуулна.",
      "examples": [
        {
          "kr": "여기가 은행이에요.",
          "mn": "Энд банк."
        },
        {
          "kr": "여기가 학교예요.",
          "mn": "Энд сургууль."
        }
      ]
    },
    {
      "id": "location",
      "title": "N에 있어요·없어요",
      "pattern": "장소 + 에 있어요 / 장소 + 에 없어요",
      "visual_rules": [
        "장소 + 에 있어요",
        "장소 + 에 없어요"
      ],
      "use_kr": "사람이나 물건의 위치를 말합니다.",
      "use_mn": "Хүн, юмны байршлыг хэлнэ.",
      "examples": [
        {
          "kr": "책이 책상 위에 있어요.",
          "mn": "Ном ширээн дээр байна."
        },
        {
          "kr": "우체국이 여기에 없어요.",
          "mn": "Шуудан энд алга."
        }
      ]
    },
    {
      "id": "destination",
      "title": "N에 가요·와요",
      "pattern": "목적지 + 에 가요 / 오는 곳 + 에 와요",
      "visual_rules": [
        "목적지 + 에 가요",
        "오는 곳 + 에 와요"
      ],
      "use_kr": "가는 곳과 오는 곳을 말합니다.",
      "use_mn": "Явах, ирэх газрыг хэлнэ.",
      "examples": [
        {
          "kr": "학교에 가요.",
          "mn": "Сургууль руу явна."
        },
        {
          "kr": "친구가 집에 와요.",
          "mn": "Найз гэрт ирнэ."
        }
      ]
    },
    {
      "id": "position",
      "title": "N 앞·뒤·옆",
      "pattern": "앞 / 뒤 / 옆 / 안",
      "visual_rules": [
        "앞 / 뒤",
        "옆 / 안"
      ],
      "use_kr": "물건의 위치를 말합니다.",
      "use_mn": "Юмны байрлалыг хэлнэ.",
      "examples": [
        {
          "kr": "은행 앞에 있어요.",
          "mn": "Банкны өмнө байна."
        },
        {
          "kr": "학교 옆에 있어요.",
          "mn": "Сургуулийн хажууд байна."
        }
      ]
    }
  ],
