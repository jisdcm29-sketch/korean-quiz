  "grammar": [
    {
      "id": "exist",
      "title": "N이/가 있어요·없어요",
      "pattern": "받침 O → 이 있어요 / 받침 X → 가 있어요",
      "visual_rules": [
        "받침 O → 이 있어요",
        "받침 X → 가 있어요"
      ],
      "use_kr": "물건이 있는지 말합니다.",
      "use_mn": "Юм байгаа эсэхийг хэлнэ.",
      "examples": [
        {
          "kr": "책이 있어요.",
          "mn": "Ном байна."
        },
        {
          "kr": "우산이 없어요.",
          "mn": "Шүхэр алга."
        }
      ]
    },
    {
      "id": "demonstrative",
      "title": "이거·그거·저거",
      "pattern": "가까이 → 이거 / 멀리 → 그거 / 저거",
      "visual_rules": [
        "가까이 → 이거",
        "멀리 → 그거 / 저거"
      ],
      "use_kr": "물건을 가리켜 말합니다.",
      "use_mn": "Юмыг зааж хэлнэ.",
      "examples": [
        {
          "kr": "이거는 사전이에요.",
          "mn": "Энэ толь бичиг."
        },
        {
          "kr": "저거는 가방이에요.",
          "mn": "Тэр цүнх."
        }
      ]
    },
    {
      "id": "request",
      "title": "N 주세요",
      "pattern": "물건 + 주세요 / 물 + 주세요",
      "visual_rules": [
        "물건 + 주세요",
        "물 + 주세요"
      ],
      "use_kr": "물건을 부탁합니다.",
      "use_mn": "Юм хүсэж авна.",
      "examples": [
        {
          "kr": "물 주세요.",
          "mn": "Ус өгнө үү."
        },
        {
          "kr": "볼펜 주세요.",
          "mn": "Үзэг өгнө үү."
        }
      ]
    },
    {
      "id": "and",
      "title": "N하고 N · N과/와 N",
      "pattern": "말할 때 → 하고 / 받침 O 과 / 받침 X 와",
      "visual_rules": [
        "말할 때 → 하고",
        "받침 O 과 / 받침 X 와"
      ],
      "use_kr": "두 명사를 연결합니다.",
      "use_mn": "Хоёр нэр үгийг холбоно.",
      "examples": [
        {
          "kr": "책하고 공책이 있어요.",
          "mn": "Ном, дэвтэр байна."
        },
        {
          "kr": "연필과 지우개 주세요.",
          "mn": "Харандаа, баллуур өгнө үү."
        }
      ]
    }
  ],
