  "grammar": [
    {
      "id": "possessive",
      "title": "N(의) N",
      "pattern": "사람/장소 + 의 + N",
      "visual_rules": [
        "사람",
        "장소 + 의 + N"
      ],
      "use_kr": "누구의 것인지 나타냅니다.",
      "use_mn": "Хэний зүйл болохыг илэрхийлнэ.",
      "examples": [
        {
          "kr": "이것은 제 어머니의 가방이에요.",
          "mn": "Энэ бол миний ээжийн цүнх."
        },
        {
          "kr": "민수의 형은 회사원이에요.",
          "mn": "Минсүгийн ах компанийн ажилтан."
        }
      ]
    },
    {
      "id": "skill",
      "title": "N을/를 잘하다·못하다",
      "pattern": "N + 을/를 + 잘해요 / 잘 못해요 / 못해요",
      "visual_rules": [
        "N + 을",
        "를 + 잘해요",
        "잘 못해요",
        "못해요"
      ],
      "use_kr": "잘하거나 못하는 것을 말합니다.",
      "use_mn": "Сайн эсвэл муу хийдэг зүйлээ хэлнэ.",
      "examples": [
        {
          "kr": "저는 한국어를 잘해요.",
          "mn": "Би солонгос хэлэндээ сайн."
        },
        {
          "kr": "동생은 수영을 못해요.",
          "mn": "Дүү усанд сэлж чаддаггүй."
        }
      ]
    },
    {
      "id": "honor_noun",
      "title": "N(이)세요",
      "pattern": "받침 O → 이세요 / 받침 X → 세요",
      "visual_rules": [
        "받침 O → 이세요",
        "받침 X → 세요"
      ],
      "use_kr": "어른을 높여서 소개합니다.",
      "use_mn": "Ахмад хүнийг хүндэтгэн танилцуулна.",
      "examples": [
        {
          "kr": "이분은 제 아버지세요.",
          "mn": "Энэ хүн миний аав."
        },
        {
          "kr": "할아버지는 선생님이세요.",
          "mn": "Өвөө багш хүн."
        }
      ]
    },
    {
      "id": "honor_verb",
      "title": "A/V-(으)시-",
      "pattern": "받침 O → 으세요 / 받침 X·ㄹ → 세요",
      "visual_rules": [
        "받침 O → 으세요",
        "받침 X·ㄹ → 세요"
      ],
      "use_kr": "어른의 행동을 높여 말합니다.",
      "use_mn": "Ахмад хүний үйлдлийг хүндэтгэн хэлнэ.",
      "examples": [
        {
          "kr": "어머니가 책을 읽으세요.",
          "mn": "Ээж ном уншиж байна."
        },
        {
          "kr": "아버지가 회사에 가세요.",
          "mn": "Аав ажилдаа явж байна."
        }
      ]
    }
  ],
