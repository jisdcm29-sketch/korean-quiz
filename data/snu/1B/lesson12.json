  "grammar": [
    {
      "id": "confirm",
      "title": "A/V-지요?·N(이)지요?",
      "pattern": "동사·형용사 + 지요? / 명사 + (이)지요?",
      "visual_rules": [
        "동사·형용사 + 지요?",
        "명사 + (이)지요?"
      ],
      "use_kr": "알고 있는 사실을 확인합니다.",
      "use_mn": "Мэдэж байгаа зүйлээ лавлана.",
      "examples": [
        {
          "kr": "오늘 수업이 있지요?",
          "mn": "Өнөөдөр хичээлтэй биз дээ?"
        },
        {
          "kr": "학생이지요?",
          "mn": "Оюутан биз дээ?"
        }
      ]
    },
    {
      "id": "progressive",
      "title": "V-고 있다",
      "pattern": "동사 + 고 있어요",
      "visual_rules": [
        "동사 + 고 있어요"
      ],
      "use_kr": "지금 하는 행동을 말합니다.",
      "use_mn": "Яг одоо хийж буй үйлдлийг хэлнэ.",
      "examples": [
        {
          "kr": "지금 책을 읽고 있어요.",
          "mn": "Одоо ном уншиж байна."
        },
        {
          "kr": "친구를 기다리고 있어요.",
          "mn": "Найзаа хүлээж байна."
        }
      ]
    },
    {
      "id": "cannot",
      "title": "못 V",
      "pattern": "못 + 동사",
      "visual_rules": [
        "못 + 동사"
      ],
      "use_kr": "할 수 없는 일을 말합니다.",
      "use_mn": "Хийж чадахгүй зүйлийг хэлнэ.",
      "examples": [
        {
          "kr": "감기에 걸려서 학교에 못 가요.",
          "mn": "Ханиад хүрээд сургуульдаа явж чадахгүй."
        },
        {
          "kr": "운전을 못 해요.",
          "mn": "Машин барьж чаддаггүй."
        }
      ]
    },
    {
      "id": "reason",
      "title": "A/V-아서/어서",
      "pattern": "ㅏ·ㅗ → 아서 / 그 외 → 어서 / 하다 → 해서",
      "visual_rules": [
        "ㅏ·ㅗ → 아서",
        "그 외 → 어서",
        "하다 → 해서"
      ],
      "use_kr": "앞 문장이 이유가 됩니다.",
      "use_mn": "Эхний өгүүлбэр шалтгаан болно.",
      "examples": [
        {
          "kr": "아파서 학교에 못 갔어요.",
          "mn": "Өвдөөд сургуульдаа явж чадаагүй."
