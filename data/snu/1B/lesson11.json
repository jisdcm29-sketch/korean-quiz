  "grammar": [
    {
      "id": "eu_drop",
      "title": "ㅡ 탈락",
      "pattern": "쓰다 → 써요 / 아프다 → 아파요 / 바쁘다 → 바빠요",
      "visual_rules": [
        "쓰다 → 써요",
        "아프다 → 아파요",
        "바쁘다 → 바빠요"
      ],
      "use_kr": "ㅡ 앞의 모음에 따라 아요/어요를 붙입니다.",
      "use_mn": "ㅡ-ийн өмнөх эгшгээс хамаарч 아요/어요 залгана.",
      "examples": [
        {
          "kr": "오늘 아주 바빠요.",
          "mn": "Өнөөдөр маш завгүй."
        },
        {
          "kr": "편지를 써요.",
          "mn": "Захиа бичнэ."
        }
      ]
    },
    {
      "id": "dont",
      "title": "V-지 마세요",
      "pattern": "동사 + 지 마세요",
      "visual_rules": [
        "동사 + 지 마세요"
      ],
      "use_kr": "하지 말아야 할 행동을 말합니다.",
      "use_mn": "Хийж болохгүй үйлдлийг хэлнэ.",
      "examples": [
        {
          "kr": "여기에서 사진을 찍지 마세요.",
          "mn": "Энд зураг авч болохгүй."
        },
        {
          "kr": "찬물을 마시지 마세요.",
          "mn": "Хүйтэн ус бүү уу."
        }
      ]
    },
    {
      "id": "only",
      "title": "N만",
      "pattern": "명사 + 만",
      "visual_rules": [
        "명사 + 만"
      ],
      "use_kr": "그것 하나만 선택합니다.",
      "use_mn": "Зөвхөн нэг зүйлийг сонгоно.",
      "examples": [
        {
          "kr": "물만 마셔요.",
          "mn": "Зөвхөн ус ууна."
        },
        {
          "kr": "오늘은 집에서만 쉬어요.",
          "mn": "Өнөөдөр зөвхөн гэртээ амарна."
        }
      ]
    },
    {
      "id": "must",
      "title": "V-아야/어야 되다",
      "pattern": "ㅏ·ㅗ → 아야 돼요 / 그 외 → 어야 돼요 / 하다 → 해야 돼요",
      "visual_rules": [
        "ㅏ·ㅗ → 아야 돼요",
        "그 외 → 어야 돼요",
        "하다 → 해야 돼요"
      ],
      "use_kr": "꼭 해야 하는 일을 말합니다.",
      "use_mn": "Заавал хийх ёстой зүйлийг хэлнэ.",
      "examples": [
        {
          "kr": "약을 먹어야 돼요.",
          "mn": "Эм уух хэрэгтэй."
        },
        {
          "kr": "오늘 일찍 자야 돼요.",
          "mn": "Өнөөдөр эрт унтах хэрэгтэй."
        }
      ]
    }
  ],
