      "visual_rules": [
        "ㅏ·ㅗ → 아서",
        "그 외 → 어서",
        "하다 → 해서"
      ],
      "use_kr": "앞의 행동 후에 다음 행동을 합니다.",
      "use_mn": "Эхний үйлдлийн дараа дараагийн үйлдлийг хийнэ.",
      "examples": [
